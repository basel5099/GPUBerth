# GPU host config: /etc/gpuberth/host.env (sourced by gpuberth-ctl as bash)
BROKER_IP=192.0.2.30
OWNER_VM=101                  # optional VM that uses the GPUs when no booking runs; empty = none
STORAGE_VM=105
KEEP_RUNNING_VMS="100"        # VMs that may run when the host powers off, such as a firewall VM
POOL_LV=pve/data
SHARED_LV=pve/vm-105-disk-2
declare -A SEAT_VM=([a]=103 [b]=104)
declare -A SEAT_IP=([a]=10.50.0.10 [b]=10.51.0.10)
# seat + gpu count = PCI mappings | memory MB | cores. Create the mappings in Proxmox first.
declare -A PROFILE=(
  [a2]="gpu0,gpu1|100000|24"
  [a1]="gpu0|50000|12"
  [b1]="gpu1|50000|12"
)
