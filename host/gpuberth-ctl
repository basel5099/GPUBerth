#!/bin/bash
# Only commands the broker may run on the GPU host. Called through a locked SSH key:
#   from="BROKER_IP",command="/usr/local/sbin/gpuberth-ctl",no-port-forwarding,no-agent-forwarding,no-X11-forwarding,no-pty ssh-ed25519 ...
# Exit 3 = refused on purpose. Agent VMs roll back to snapshot "clean"; kept data lives on the storage VM.
source /etc/gpuberth/host.env

running() { qm status "$1" 2>/dev/null | grep -q running; }
seat_vm() { [ -n "${SEAT_VM[$1]}" ] && echo "${SEAT_VM[$1]}" || { echo "bad seat" >&2; exit 2; }; }
any_seat_running() { local v; for v in "${SEAT_VM[@]}"; do running "$v" && return 0; done; return 1; }

owner_busy() {
  local out users util
  out=$(timeout 25 qm guest exec "$OWNER_VM" --timeout 15 -- sh -c 'who | wc -l; nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits' 2>/dev/null) || return 0
  users=$(python3 -c 'import sys,json; print(json.load(sys.stdin).get("out-data",""))' <<<"$out" | head -1)
  util=$(python3 -c 'import sys,json; print(max([int(x) for x in json.load(sys.stdin).get("out-data","").split()[1:]] or [0]))' <<<"$out")
  [ "${users:-1}" -gt 0 ] || [ "${util:-100}" -gt 10 ]
}

start_storage() {
  running "$STORAGE_VM" || qm start "$STORAGE_VM" || return 1
  for _ in $(seq 1 40); do
    qm agent "$STORAGE_VM" ping >/dev/null 2>&1 && return 0
    sleep 3
  done
  echo "storage VM not ready" >&2; return 1
}

share_cmd() {
  # qm guest exec returns 0 even when the command fails, so read the real exit code
  local out
  out=$(timeout 30 qm guest exec "$STORAGE_VM" --timeout 25 -- /usr/local/sbin/gpuberth-share "$@") || return 1
  python3 -c 'import sys,json; sys.exit(json.load(sys.stdin).get("exitcode",1))' <<<"$out"
}

set -f  # no file name expansion on the remote command
set -- $SSH_ORIGINAL_COMMAND
verb=$1
case "$verb" in
status)
  owner=false; busy=false; storage=false; seats=""
  if [ -n "$OWNER_VM" ] && running "$OWNER_VM"; then owner=true; owner_busy && busy=true; fi
  running "$STORAGE_VM" && storage=true
  for s in "${!SEAT_VM[@]}"; do
    state=false; running "${SEAT_VM[$s]}" && state=true
    seats+="\"$s\":$state,"
  done
  pool=$(lvs --noheadings -o data_percent "$POOL_LV" 2>/dev/null | tr -d ' ' | cut -d. -f1)
  shared=$(lvs --noheadings -o data_percent "$SHARED_LV" 2>/dev/null | tr -d ' ' | cut -d. -f1)
  printf '{"owner":%s,"seats":{%s},"storage":%s,"busy":%s,"pool_pct":%s,"shared_pct":%s}\n' \
    $owner "${seats%,}" $storage $busy "${pool:-0}" "${shared:-0}"
  ;;
stop-owner)
  [ -n "$OWNER_VM" ] && running "$OWNER_VM" || exit 0
  qm shutdown "$OWNER_VM" --timeout 120 --forceStop 0
  ;;
start-owner)
  [ -n "$OWNER_VM" ] || exit 0
  running "$OWNER_VM" && exit 0
  if any_seat_running; then echo "agent VM has the GPUs" >&2; exit 3; fi
  qm start "$OWNER_VM"
  ;;
start)
  # start <seat> <gpus>
  seat=$2; gpus=$3; vm=$(seat_vm "$seat") || exit 2
  profile=${PROFILE[$seat$gpus]}
  [ -n "$profile" ] || { echo "bad seat/gpus" >&2; exit 2; }
  running "$vm" && exit 0
  if [ -n "$OWNER_VM" ] && running "$OWNER_VM"; then echo "owner VM has the GPUs" >&2; exit 3; fi
  start_storage || exit 1
  IFS='|' read -r mappings memory cores <<<"$profile"
  args=(); i=0
  for m in ${mappings//,/ }; do args+=(--"hostpci$i" "mapping=$m,pcie=1"); i=$((i+1)); done
  qm set "$vm" "${args[@]}" --memory "$memory" --cores "$cores" >/dev/null
  qm start "$vm"
  ;;
stop)
  # stop <seat>
  seat=$2; vm=$(seat_vm "$seat") || exit 2
  if running "$vm"; then
    qm shutdown "$vm" --timeout 45 --forceStop 1 || qm stop "$vm"
  fi
  qm rollback "$vm" clean || exit 1
  if ! any_seat_running && running "$STORAGE_VM"; then
    qm shutdown "$STORAGE_VM" --timeout 60 --forceStop 1
  fi
  ;;
share)
  # share <seat> <agent>
  seat=$2; agent=$3; ip=${SEAT_IP[$seat]}
  [ -n "$ip" ] || { echo "bad seat" >&2; exit 2; }
  [[ "$agent" =~ ^[a-z0-9-]{1,32}$ ]] || { echo "bad agent" >&2; exit 2; }
  start_storage || exit 1
  share_cmd add "$ip" "$agent"
  ;;
unshare)
  seat=$2; ip=${SEAT_IP[$seat]}
  [ -n "$ip" ] || { echo "bad seat" >&2; exit 2; }
  running "$STORAGE_VM" || exit 0
  share_cmd del "$ip"
  ;;
poweroff)
  others=$(qm list | awk -v keep="$KEEP_RUNNING_VMS $STORAGE_VM" 'BEGIN{split(keep,a," ");for(i in a)k[a[i]]=1} NR>1 && $3=="running" && !($1 in k){print $1}')
  [ -z "$others" ] || { echo "VMs still running: $others" >&2; exit 3; }
  # the broker's own session also shows up in who
  [ -z "$(who | grep -v "($BROKER_IP)")" ] || { echo "somebody is logged in" >&2; exit 3; }
  running "$STORAGE_VM" && qm shutdown "$STORAGE_VM" --timeout 60 --forceStop 1
  systemd-run --on-active=2 /usr/sbin/poweroff >/dev/null 2>&1
  ;;
*)
  echo "not allowed" >&2; exit 2
  ;;
esac
